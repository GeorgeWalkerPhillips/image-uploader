REACT_APP_SUPABASE_URL=your_supabase_project_url
REACT_APP_SUPABASE_ANON_KEY=your_anon_key
REACT_APP_MAX_FILE_SIZE=31457280
REACT_APP_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/heic
REACT_APP_RATE_LIMIT_UPLOADS_PER_MINUTE=10

# Optional: Meta Pixel ID (numbers only, from Events Manager). Leave blank to disable all tracking.
REACT_APP_META_PIXEL_ID=
